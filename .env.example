POLL_INTERVAL_MS=300000
REQUEST_DELAY_MS=10000

PRICE_POLL_INTERVAL_MS=300000
PRICE_REQUEST_CONCURRENCY=4
PRICE_CANDLE_LIMIT=20000

# TELEGRAM
BOT_TOKEN=
CHAT_ID=
TELEGRAM_ENABLED=true
TELEGRAM_NOTIFY_STARTUP=true

# PHASE 7 — PAPER TRADING
PAPER_STARTING_BALANCE=1000
PAPER_TRADING_DURATION_MS=604800000
PAPER_PRICE_TIMEFRAME=5m
PAPER_MAX_PRICE_AGE_MS=900000
PAPER_POSITION_SIZE_PCT=2
PAPER_MAX_EXPOSURE_PCT=50
PAPER_MAX_OPEN_POSITIONS=5
PAPER_STOP_LOSS_PCT=2
PAPER_TAKE_PROFIT_PCT=4
PAPER_FEE_PCT_PER_SIDE=0.05
PAPER_SLIPPAGE_PCT_PER_SIDE=0.02
PAPER_ENTRY_CONFIRMATION_MS=300000

# BROKER / DATA
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

MASSIVE_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=

DATABASE_PATH=./data/signals.duckdb
BIQUOTE_MAPPING_FILE=data/biquote-mapping.csv

TOR_ENABLED=false

# APEX / CRYPTO FUTURES
# Testnet keys must be created in the ApeX Omni Testnet portal; mainnet keys are rejected there.
# Market data, private account API and execution are configured independently.
APEX_ENV=testnet
APEX_MARKET_DATA_ENV=testnet
APEX_PRIVATE_API_ENABLED=false
APEX_PRIVATE_API_ENV=testnet
APEX_ORDER_SUBMISSION_ENABLED=false
EXCHANGE=apex
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
OMNIAPEX_API_KEY=
OMNIAPEX_API_SECRET=
OMNIAPEX_PASS_PHRASE=
# Omni/ZK signing material; required only for order placement.
APEX_OMNI_SEEDS=

# RESEARCH ENGINE / MARKET DATA
RESEARCH_DATABASE_PATH=./data/research.duckdb
# Comma-separated symbols (BTC, BTC-USDT or BTC/USDT:USDT). Empty = default majors.
APEX_SYMBOLS=
APEX_UNIVERSE_SIZE=10
APEX_TIMEFRAME=5m
APEX_BACKFILL_DAYS=30
APEX_REQUEST_DELAY_MS=250

# PARADEX / CRYPTO FUTURES (USDC-settled)
# Testnet is the initial environment. Market data, private API and execution
# are configured independently, so research can read mainnet candles while
# execution stays on testnet.
PARADEX_ENV=testnet
PARADEX_MARKET_DATA_ENV=testnet
PARADEX_PRIVATE_API_ENABLED=false
PARADEX_PRIVATE_API_ENV=testnet
PARADEX_ORDER_SUBMISSION_ENABLED=false
# auto = try the account key endpoint, then the subkey endpoint.
# account = PARADEX_PRIVATE_KEY is the account's main key.
# subkey = PARADEX_PRIVATE_KEY is a registered subkey (signs in at /v1/auth/{public_key}).
PARADEX_AUTH_MODE=auto
# Paradex account keypair from the Paradex UI (StarkNet). Never commit these.
# PARADEX_PUBLICK_KEY keeps its historical spelling on purpose.
PARADEX_PRIVATE_KEY=
PARADEX_PUBLICK_KEY=
PARADEX_ADDRESS=
# Alternate auth path: an EVM wallet Paradex derives the account from.
PARADEX_WALLET_ADDRESS=
PARADEX_EVM_PRIVATE_KEY=

PARADEX_SYMBOLS=
PARADEX_UNIVERSE_SIZE=10
PARADEX_TIMEFRAME=5m
PARADEX_BACKFILL_DAYS=30
PARADEX_REQUEST_DELAY_MS=250

# LIGHTER / CRYPTO FUTURES (USDC-settled)
# Testnet is the initial environment. Market data, private API and execution
# are configured independently. Lighter testnet has only a short candle
# history, so research normally points market data at mainnet.
LIGHTER_ENV=testnet
LIGHTER_MARKET_DATA_ENV=testnet
LIGHTER_PRIVATE_API_ENABLED=false
LIGHTER_PRIVATE_API_ENV=testnet
LIGHTER_ORDER_SUBMISSION_ENABLED=false
# REST host per environment. The web app (testnet.app.lighter.xyz) uses
# api.testnet.lighter.xyz; the docs reference API is
# testnet.zklighter.elliot.ai. Accounts and API keys exist on only one of them,
# so match the host where the key was created. Absolute HTTPS URLs only.
LIGHTER_MAINNET_BASE_URL=https://mainnet.zklighter.elliot.ai
LIGHTER_TESTNET_BASE_URL=https://api.testnet.lighter.xyz
# API key pair from the Lighter UI (Settings -> API Keys). The private key is
# never committed. Indexes 0-3 are reserved for the web/mobile clients.
LIGHTER_PRIVATE_KEY=
LIGHTER_PUBLIC_KEY=
LIGHTER_ACCOUNT_INDEX=
LIGHTER_KEY_INDEX=
# CCXT signs Lighter requests with a wasm runtime. Run `bun run lighter:setup`
# to download it into the gitignored cache; override the paths if you host it.
LIGHTER_LIBRARY_PATH=.cache/lighter/lighter.wasm
LIGHTER_WASM_EXEC_PATH=.cache/lighter/wasm_exec.js

# FUTURES EXECUTION (mirror Phase 7 paper positions onto the account)
# Execution needs every gate above plus LIGHTER_EXECUTION_ENABLED=true, and it
# is restricted to the testnet private API unless LIGHTER_ALLOW_MAINNET_EXECUTION
# is set. Paper trading stays the source of truth: entries and exits are
# replayed as market orders and every close is reduce-only.
LIGHTER_EXECUTION_ENABLED=false
LIGHTER_LEVERAGE=5
LIGHTER_MARGIN_MODE=cross
# Optional restriction on which venue markets are mirrored. Empty (the
# default) mirrors every perpetual the deployment lists and resolves each paper
# symbol against the venue's own market list (BTC/USD -> BTC, EUR/USD ->
# EURUSD, XAUUSD -> XAU). Set a comma-separated list to narrow it. Leverage
# only reduces the margin reserved - the venue size is the paper size times
# LIGHTER_SIZE_MULTIPLIER.
LIGHTER_EXECUTION_SYMBOLS=
# The paper book is small ($1,000 at 2% = $20 per trade), which can fall below
# the venue minimum order. Scale the venue quantity here; 1 mirrors paper.
LIGHTER_SIZE_MULTIPLIER=1
# Hard cap on one entry, in USD. 0 disables it, but a multiplier above 1 is
# refused at startup unless this is nonzero.
LIGHTER_MAX_NOTIONAL_USD=100
# Close every bot-owned position on a clean shutdown. SIGKILL cannot run this.
LIGHTER_FLATTEN_ON_SHUTDOWN=true
# Extra tolerance over the best quote when signing the worst acceptable price.
LIGHTER_WORST_PRICE_SLIPPAGE_PCT=1
LIGHTER_ALLOW_MAINNET_EXECUTION=false
LIGHTER_RECONCILE_INTERVAL_MS=60000

LIGHTER_SYMBOLS=
LIGHTER_UNIVERSE_SIZE=10
LIGHTER_TIMEFRAME=5m
LIGHTER_BACKFILL_DAYS=30
LIGHTER_REQUEST_DELAY_MS=250
