{
  "name": "daily_signals",
  "module": "src/main.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "start": "bun run src/main.ts",
    "prices:once": "bun run src/collect-prices.ts",
    "validate": "bun run src/validate.ts",
    "e4": "bun run src/e4-cli.ts",
    "e3": "bun run src/e3-cli.ts",
    "test": "bun test",
    "audit:deep": "bun run src/deep-audit.ts",
    "apex:smoke": "bun run src/exchanges/apex/smoke-test.ts",
    "apex:markets": "EXCHANGE=apex bun run src/market-data/market-metadata.ts",
    "apex:backfill": "EXCHANGE=apex bun run src/market-data/backfill-cli.ts",
    "paradex:smoke": "bun run src/exchanges/paradex/smoke-test.ts",
  "paradex:account": "bun run src/exchanges/paradex/account-check.ts",
    "paradex:markets": "EXCHANGE=paradex bun run src/market-data/market-metadata.ts",
    "paradex:backfill": "EXCHANGE=paradex bun run src/market-data/backfill-cli.ts",
