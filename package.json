    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^5.0.0",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@paradex/sdk": "^0.9.0",
    "apexomni-connector-node": "^0.3.2-alpha.1",
    "biquote": "^0.3.0",
    "ccxt": "^4.5.93",
    "cheerio": "^1.2.0",
    "ethers": "^6.17.0",
    "finnhub": "^2.0.16",
    "grammy": "^1.46.0",
    "starknet": "^8.9.2",
    "telegram-markdown-v2": "^0.0.5",
    "tor-js": "^0.4.4"
  }
